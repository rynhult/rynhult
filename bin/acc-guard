#!/usr/bin/python3 -I
"""Rynhult guardrails: the agents' pre-tool hook.   acc-guard <provider> [event]

Reads the tool call (JSON on stdin), checks it against the session's rules ($ACC_RUN_DIR/guardrails.json, written at
launch from Settings -> Guardrails), records the event like acc-hook (with a "guard" entry when it blocks), and answers
in the CLI's own format, whatever the CLI's permission mode. Outside a Rynhult session it allows everything; inside one, a
policy that is missing, unreadable or changed since launch ($ACC_GUARD_FILES holds the launch files' hashes) blocks
every tool call. Its own files (the run folder, the CLIs' hook settings) can't be changed through it. It is a safety
net against mistakes and casual prompt injection, not a sandbox: the agent's account can still do what it may.
Standard library only: it runs before every tool call.

Shell commands are parsed the way a shell reads them (quotes, comments, continuations, heredocs, subshells, groups,
command substitutions, `sh -c` and `eval` scripts, wrappers such as sudo/env/timeout) and every command that would run
is checked, with the directory it would run in. Text that is only printed or searched for is not a command or a file.
"""

import os as _compat_os
import runpy as _compat_runpy
import stat as _compat_stat
from pathlib import Path as _CompatPath


def _compat_reader(relative):
    # Root runs most of these helpers: load only a reader owned like this script that no one else can change,
    # and never fall back past an installed reader that fails the check. Exit 2 also makes acc-guard block.
    here = _CompatPath(__file__).resolve()
    mine = here.stat()
    for candidate in (here.with_name("acc_env.py"), here.parent / relative):
        try:
            info = candidate.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            break
        if _compat_stat.S_ISREG(info.st_mode) and info.st_uid == mine.st_uid and not info.st_mode & 0o002 and (
                not info.st_mode & 0o020 or info.st_gid == mine.st_gid):
            if _compat_os.geteuid() == 0:
                for path in (candidate, *candidate.parents):
                    try:
                        checked = path.stat(follow_symlinks=False)
                    except OSError:
                        break
                    sticky = _compat_stat.S_ISDIR(checked.st_mode) and checked.st_mode & _compat_stat.S_ISVTX
                    if checked.st_uid != 0 or (checked.st_mode & 0o022 and not sticky):
                        break
                else:
                    return _compat_runpy.run_path(str(candidate))
                break
            return _compat_runpy.run_path(str(candidate))
        break
    print(f"{here.name}: refusing an unsafe or missing settings reader beside it", file=__import__("sys").stderr)
    raise SystemExit(2)


_compat = _compat_reader("../src/acc/env.py")
environment = _compat["environment"]
Environment = _compat["Environment"]
