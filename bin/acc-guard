def tool_call(payload: dict) -> tuple[str, dict]:
    """The tool's name and arguments, whichever CLI sent them."""
    call = payload.get("toolCall") if isinstance(payload.get("toolCall"), dict) else {}
    name = payload.get("tool_name") or payload.get("toolName") or call.get("name") or ""
    args = payload.get("tool_input", payload.get("toolArgs", payload.get("toolInput", call.get("args"))))
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except ValueError:
            # A bare string is a command only for a shell tool; for an edit tool it is the patch or file text, whose
            # contents are not run (its file names are still checked: patch_paths)
            shell = re.search(r"bash|shell|run|exec|command|terminal", str(name), re.I)
            args = {"command": args} if shell else {"input": args}
    return str(name), args if isinstance(args, dict) else {}


def strings(args: dict, keys: tuple[str, ...]) -> list[str]:
    found = []
    for key in keys:
        value = args.get(key)
        if isinstance(value, str) and value.strip():
            found.append(value)
        elif isinstance(value, list):
            found += [v for v in value if isinstance(v, str)]
    return found


def patch_paths(args: dict) -> list[str]:
    """Codex's apply_patch and OpenCode's patch name their files inside the patch text (a move names two)."""
    text = " ".join(v for v in args.values() if isinstance(v, str))
    return re.findall(r"^\*\*\* (?:(?:Add|Update|Delete) File|Move to): (.+)$", text, re.M)



# --- Reading shell commands -------------------------------------------------------------------------------------------
# Enough of the shell's grammar to know which commands run, with which words, in which directory. Nothing is executed
# or expanded: an expansion ($VAR, $(...), globs aside) stays unknown, and the rules treat unknown as possibly bad.

META = frozenset(" \t\n;&|()<>")
OPERATORS = ("&&", "||", ";;&", ";;", ";&", "|&", ";", "&", "|", "(", ")")
REDIRECTS = ("&>>", "&>", "<<<", "<<-", "<<", "<>", "<&", ">>", ">&", ">|", "<", ">")
FD_PREFIX = re.compile(r"\d+(?=[<>])|\{[A-Za-z_][A-Za-z0-9_]*\}(?=[<>])")
PARAMETER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*|[0-9@*#?$!-]")
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(\[[^\]]*\])?\+?=")
KEYWORDS = frozenset(("!", "if", "then", "elif", "else", "fi", "do", "done", "while", "until", "esac", "coproc"))
DATA_KEYWORDS = frozenset(("for", "select", "case", "function"))  # their words name things; they run nothing


class Word:
    """One shell word: its text after quote removal, and how each character was written: 'u' unquoted, 'q' quoted or
    escaped, '$' part of an expansion or substitution. `subs` holds the scripts of its command substitutions."""
    __slots__ = ("text", "how", "subs")

    def __init__(self, text="", how=None, subs=None):
        self.text, self.how, self.subs = text, how if how is not None else "u" * len(text), subs if subs is not None else []

    def add(self, text: str, how: str):
        self.text += text
        self.how += how * len(text)

    def tail(self, start: int) -> "Word":
        return Word(self.text[start:], self.how[start:])

    @property
    def dynamic(self) -> bool:
        return "$" in self.how

    @property
    def tilde(self) -> bool:
        return self.text[:1] == "~" and self.how[:1] == "u"

    @property
    def bare(self) -> bool:
        return self.how == "u" * len(self.text)


class Heredoc:
    """A `<<WORD` redirection; its body is filled in when the parser reaches the end of the line."""
    __slots__ = ("delimiter", "quoted", "strip", "body", "subs")

    def __init__(self, word: Word, strip: bool):
        self.delimiter, self.quoted, self.strip, self.body, self.subs = word.text, not word.bare, strip, "", []


class Command:
    """A simple command: leading assignments, words, redirections [(operator, Word or Heredoc)]."""
    __slots__ = ("assigns", "words", "redirs", "data")

    def __init__(self):
        self.assigns, self.words, self.redirs, self.data = [], [], [], False


class Parser:
    """Shell source -> a list of [node, separator after it]; a node is a Command, ("sub", list) or ("group", list)."""

    def __init__(self, source: str):
        self.s, self.i, self.pending = source, 0, []

    def parse(self) -> list:
        return self.parse_list(None)

    def parse_list(self, closer):
        items, cmd = [], None
        while True:
            kind, value = self.token()
            if kind == "eof":
                break
            if kind == "op":
                if value == ")":
                    if closer == ")":
                        break
                    value = ";"  # a stray ")" (a case pattern, say) just ends the command
                if value == "(":
                    array = cmd is not None and not cmd.words and cmd.assigns and self.s[self.i - 2:self.i - 1] == "="
                    if cmd is not None:
                        items.append([cmd, ";"])
                        cmd = None
                    inner = self.parse_list(")")
                    if array:  # name=(a b c): words, not commands
                        for node, _ in inner:
                            if isinstance(node, Command):
                                node.data = True
                    items.append([("sub", inner), None])
                    continue
                if cmd is not None:
                    items.append([cmd, value])
                    cmd = None
                elif items and items[-1][1] is None:
                    items[-1][1] = value
                continue
            if kind == "redir":
                cmd = cmd or Command()
                if value in ("<<", "<<-"):
                    self.blank()
                    doc = Heredoc(self.word(), value == "<<-")
                    self.pending.append(doc)
                    cmd.redirs.append((value, doc))
                else:
                    cmd.redirs.append((value, self.operand()))
                continue
            word = value
            if cmd is not None and cmd.data and word.bare and word.text == "{" and cmd.words[0].text == "function":
                items.append([cmd, ";"])  # function NAME { ...; }: the body runs like any other group
                cmd = None
            if cmd is None and word.bare:
                if word.text == "{":
                    items.append([("group", self.parse_list("}")), None])
                    continue
                if word.text == "}":
                    if closer == "}":
                        break
                    continue
                if word.text in KEYWORDS:
                    continue
                if word.text in DATA_KEYWORDS:
                    cmd = Command()
                    cmd.data = True
            cmd = cmd or Command()
            match = ASSIGNMENT.match(word.text) if not cmd.words else None
            if match and word.how[:match.end()] == "u" * match.end():
                cmd.assigns.append(word)
            else:
                cmd.words.append(word)
        if cmd is not None:
            items.append([cmd, None])
        return items

    def blank(self):
        s = self.s
        while self.i < len(s):
            c = s[self.i]
            if c in " \t":
                self.i += 1
            elif c == "\\" and s.startswith("\\\n", self.i):
                self.i += 2
            elif c == "#":  # a comment runs to the end of the line
                end = s.find("\n", self.i)
                self.i = len(s) if end < 0 else end
            else:
                break

    def token(self):
        self.blank()
        s = self.s
        if self.i >= len(s):
            return "eof", None
        if s[self.i] == "\n":
            self.i += 1
            self.heredocs()
            return "op", "\n"
        if s.startswith(("<(", ">("), self.i):
            return "word", self.operand()
        fd = FD_PREFIX.match(s, self.i)
        start = fd.end() if fd else self.i
        for op in REDIRECTS:
            if s.startswith(op, start):
                self.i = start + len(op)
                return "redir", op
        for op in OPERATORS:
            if s.startswith(op, self.i):
                self.i += len(op)
                return "op", op
        return "word", self.word()

    def operand(self) -> Word:
        """A redirection's target or a word: process substitutions <(...) >(...) included."""
        self.blank()
        if self.s.startswith(("<(", ">("), self.i):
            word, start = Word(), self.i
            self.i = self.substitution(self.i + 2, word)
            word.add(self.s[start:self.i], "$")
            return word
        return self.word()

    def word(self) -> Word:
        word, s = Word(), self.s
        n = len(s)
        while self.i < n:
            c = s[self.i]
            if c in META:
                break
            if c == "\\":
                if s.startswith("\\\n", self.i):
                    self.i += 2
                    continue
                word.add(s[self.i + 1:self.i + 2] or "\\", "q")
                self.i += 2
            elif c == "'":
                end = s.find("'", self.i + 1)
                end = n if end < 0 else end
                word.add(s[self.i + 1:end], "q")
                self.i = end + 1
            elif c == '"':
                self.i = self.dquote(self.i + 1, word)
            elif c == "$":
                self.i = self.dollar(self.i, word, False)
            elif c == "`":
                self.i = self.backtick(self.i, word)
            else:
                word.add(c, "u")
                self.i += 1
        self.i = min(self.i, n)
        return word

    def dquote(self, i: int, word: Word) -> int:
        s, n = self.s, len(self.s)
        while i < n and s[i] != '"':
            c = s[i]
            if c == "\\" and i + 1 < n and s[i + 1] in '$`"\\\n':
                if s[i + 1] != "\n":
                    word.add(s[i + 1], "q")
                i += 2
            elif c == "$":
                i = self.dollar(i, word, True)
            elif c == "`":
                i = self.backtick(i, word)
            else:
                word.add(c, "q")
                i += 1
        return min(i + 1, n)

    def dollar(self, i: int, word: Word, quoted: bool) -> int:
        s, n = self.s, len(self.s)
        after = s[i + 1:i + 2]
        if s.startswith("$((", i):  # arithmetic; it can still hold command substitutions
            j, depth = i + 3, 0
            while j < n and not (depth == 0 and s.startswith("))", j)):
                depth += {"(": 1, ")": -1}.get(s[j], 0)
                j += 1
            inner, end = s[i + 3:j], min(j + 2, n)
            if "$(" in inner or "`" in inner:
                word.subs.append(Parser(inner).parse())
            word.add(s[i:end], "$")
            return end
        if after == "(":
            end = self.substitution(i + 2, word)
            word.add(s[i:end], "$")
            return end
        if after == "{":
            end = self.braced(i + 2, word)
            word.add(s[i:end], "$")
            return end
        if after == "'" and not quoted:  # $'...': ANSI-C quoting, literal text
            j, text = i + 2, ""
            while j < n and s[j] != "'":
                if s[j] == "\\" and j + 1 < n:
                    text += {"n": "\n", "t": "\t"}.get(s[j + 1], s[j + 1])
                    j += 2
                else:
                    text += s[j]
                    j += 1
            word.add(text, "q")
            return min(j + 1, n)
        if after == '"' and not quoted:
            return self.dquote(i + 2, word)
        name = PARAMETER.match(s, i + 1)
        if name:
            word.add(s[i:name.end()], "$")
            return name.end()
        word.add("$", "q" if quoted else "u")
        return i + 1

    def substitution(self, i: int, word: Word) -> int:
        """$(...) or <(...) from just inside the parenthesis; returns the index after the closing one."""
        inner = Parser(self.s)
        inner.i = i
        word.subs.append(inner.parse_list(")"))
        return inner.i

    def braced(self, i: int, word: Word) -> int:
        """${...} from just inside the brace: its default values can hold substitutions too."""
        s, n, depth, sink = self.s, len(self.s), 1, Word()
        while i < n and depth:
            c = s[i]
            if c == "\\":
                i += 2
            elif c == "'":
                end = s.find("'", i + 1)
                i = n if end < 0 else end + 1
            elif c == '"':
                i = self.dquote(i + 1, sink)
            elif c == "$":
                i = self.dollar(i, sink, True)
            elif c == "`":
                i = self.backtick(i, sink)
            else:
                depth += {"{": 1, "}": -1}.get(c, 0)
                i += 1
        word.subs += sink.subs
        return min(i, n)

    def backtick(self, i: int, word: Word) -> int:
        s, n, j, inner = self.s, len(self.s), i + 1, []
        while j < n and s[j] != "`":
            if s[j] == "\\" and j + 1 < n and s[j + 1] in "`$\\":
                inner.append(s[j + 1])
                j += 2
            else:
                inner.append(s[j])
                j += 1
        word.subs.append(Parser("".join(inner)).parse())
        word.add(s[i:j + 1], "$")
        return min(j + 1, n)

    def heredocs(self):
        """Read the bodies of the heredocs started on the line that just ended."""
        s = self.s
        for doc in self.pending:
            lines = []
            while self.i < len(s):
                end = s.find("\n", self.i)
                end = len(s) if end < 0 else end
                line, self.i = s[self.i:end], end + 1
                if (line.lstrip("\t") if doc.strip else line) == doc.delimiter:
                    break
                lines.append(line)
            self.i = min(self.i, len(s))
            doc.body = "\n".join(lines)
            if not doc.quoted:  # an unquoted delimiter: $(...) and `...` in the body run
                doc.subs = expansions(doc.body)
        self.pending = []


def expansions(text: str) -> list:
    """The command substitutions in text that is expanded but not otherwise run (a heredoc body)."""
    parser, sink, i = Parser(text), Word(), 0
    while i < len(text):
        if text[i] == "\\":
            i += 2
        elif text[i] == "$":
            i = parser.dollar(i, sink, True)
        elif text[i] == "`":
            i = parser.backtick(i, sink)
        else:
            i += 1
    return sink.subs


# --- What a command does -----------------------------------------------------------------------------------------------

HOME = "/~home"  # the home directory: where it really is doesn't matter, only that it is outside the workspace
HOME_PREFIX = re.compile(r"^(~|\$HOME|\$\{HOME\})(?=/|$)")
SHELLS = frozenset(("sh", "bash", "zsh", "dash", "ksh", "ash", "mksh"))
TEXT_COMMANDS = frozenset(("echo", "printf", "print", ":", "true", "false", "which", "type"))  # arguments are text
# Commands that run the rest of their words as a command: (short options taking a value, long ones taking a value)
WRAPPERS = {
    "busybox": ("", set()),
    "flock": ("cwE", {"--command", "--wait", "--timeout", "--conflict-exit-code"}),
    "script": ("cIOBT", {"--command", "--log-in", "--log-out", "--log-io", "--log-timing"}),
    "su": ("cgs", {"--command", "--session-command", "--group", "--supp-group", "--shell"}),
    "sudo": ("CDghpRrTtUu", {"--user", "--group", "--chdir", "--chroot", "--prompt", "--role", "--type", "--host",
                             "--other-user", "--close-from", "--command-timeout"}),
    "doas": ("uC", set()),
    "env": ("uCSP", {"--unset", "--chdir", "--split-string"}),
    "command": ("", set()),
    "builtin": ("", set()),
    "exec": ("a", set()),
    "time": ("fo", {"--format", "--output"}),
    "nice": ("n", {"--adjustment"}),
    "nohup": ("", set()),
    "stdbuf": ("ioe", {"--input", "--output", "--error"}),
