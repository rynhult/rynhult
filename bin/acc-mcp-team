# Set by the launch (teams.team_files): the v2 preview's tools only with its one switch on; the working list's and the
# plan's only with their own switch too. accd refuses every v2 tool while the preview is off, whatever this lists.
# Only accd's arguments count, never the agent's own environment, so an agent can't list tools it can't use (review L-6).
PREVIEW = '--orchestrator' in sys.argv[1:]
if not PREVIEW or '--orchestrator-v2' not in sys.argv[1:]:
    BRIEF_TOOLS = {}
    WORKLIST_TOOLS = {}
    PLAN_TOOLS = {}
TOOLS = ({**M17_TOOLS, **WORKLIST_TOOLS, **SELECTION_TOOLS, **DELIVERY_TOOLS, **GATE_TOOLS, **PLAN_TOOLS, **BRIEF_TOOLS} if PREVIEW
         else dict(M17_TOOLS))


# Originals delivered by brief_reference create private files. Reports,
# proposals and reference sharing persist state and must not claim to be reads.
READ_ONLY_TOOLS = frozenset(('list', 'status', 'read', 'worklist', 'selection_status',
                            'gate_status', 'plan', 'plan_version', 'brief', 'brief_documents'))


def call(name, args):
    if name not in TOOLS or not isinstance(args, dict) or set(args) - set(TOOLS[name][1]):
        raise ValueError('invalid tool or arguments')
    run, session = environment.get('ACC_RUN_DIR'), environment.get('ACC_SESSION_ID')
    if not run or not session:
        raise ValueError('acc-team works only inside a Rynhult team session')
    request_id = uuid.uuid4().hex
    record = {'acc_session': session, 'provider': 'acc', 'hook': {'hook_event_name': 'AccTeam',
              'request': {'id': request_id, 'action': name, **args}}}
    data = (json.dumps(record) + '\n').encode()
    if len(data) > 64000:
        raise ValueError('team request too large')
    fd = os.open(str(Path(run)/'events.jsonl'), os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    answer = Path(run)/'team'/(request_id+'.json')
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        try:
            result = json.loads(answer.read_text())
        except FileNotFoundError:
            time.sleep(.1)
            continue
        if not result.get('ok'):
            raise ValueError(result.get('error', 'team request refused'))
        return result.get('result')
    raise ValueError(f'Rynhult has not answered {request_id}; inspect the team before retrying')


def main():
    for line in sys.stdin:
        message = None
        try:
            message = json.loads(line)
            if 'id' not in message:
                continue
            method = message.get('method')
            if method == 'initialize':
                result = {'protocolVersion': message.get('params', {}).get('protocolVersion', '2024-11-05'),
                          'capabilities': {'tools': {}}, 'serverInfo': {'name': 'acc-team', 'version': '1.0'}}
            elif method == 'ping':
                result = {}
            elif method == 'tools/list':
                result = {'tools': [{'name': name, 'description': spec[0], 'inputSchema': {
                    'type': 'object', 'properties': spec[1], 'required': spec[2], 'additionalProperties': False},
                    'annotations': {'readOnlyHint': name in READ_ONLY_TOOLS}}
                    for name, spec in TOOLS.items()]}
            elif method == 'tools/call':
                params = message.get('params') or {}
                try:
                    value = call(params.get('name'), params.get('arguments', {}))
                    result = {'content': [{'type': 'text', 'text': json.dumps(value)}]}
                except Exception as error:
                    result = {'isError': True, 'content': [{'type': 'text', 'text': str(error)}]}
            else:
                raise ValueError('unsupported method')
            reply = {'jsonrpc': '2.0', 'id': message['id'], 'result': result}
        except Exception as error:
            reply = {'jsonrpc': '2.0', 'id': message.get('id') if isinstance(message, dict) else None,
                     'error': {'code': -32600, 'message': str(error)}}
        print(json.dumps(reply), flush=True)


if __name__ == '__main__':
    main()
