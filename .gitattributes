# Shell scripts and units run on Linux (and inside WSL from a Windows checkout): keep LF endings everywhere.
*.sh text eol=lf
*.service text eol=lf
*.socket text eol=lf
*.conf text eol=lf
*.plist text eol=lf
*.plist.in text eol=lf
deploy/broker/acc-* text eol=lf
deploy/node/acc-node text eol=lf
bin/* text eol=lf
# PowerShell 5.1 reads CRLF and LF alike; CRLF keeps Notepad happy.
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Root updater and path units also ship through the Windows installer into WSL.
deploy/updates/* text eol=lf
