[Unit]
Description=Rynhult: install or update agent software requested from the dashboard (acc-packages)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/acc-packages
TimeoutStartSec=45min
# Installs system packages (npm -g, apt, a vendor's install script), so it keeps write access to /usr, /etc and /var.
# Requests name fixed catalog entries or validated system-registry tools, never commands, URLs or scripts.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
Alias=rynhult-packages.service
