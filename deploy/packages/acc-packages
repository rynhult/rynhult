#!/usr/bin/python3 -I
"""acc-packages: root helper that installs and updates the software Rynhult's agents use.

accd (user acc, unprivileged) can't install software. An owner asks from the dashboard; accd drops
/srv/acc/packages/requests/<id>.json ({"id", "action", "package", "auto"}) and acc-packages.path starts this helper.
acc-packages-daily.timer runs `acc-packages --daily`: it checks every package and updates the installed ones whose
auto-update is on.

Catalog actions name an entry in CATALOG, never a command, version, URL or path. Catalog state (installed and latest
versions, auto-update, the last result) goes to /srv/acc/packages/state.json (root:acc 0640) for the dashboard.

M16's separately approved action "tool" accepts only validated apt/snap/flatpak registry coordinates and
install/remove, using the deployed acc-tool-policy.py's fixed argv. Its request has exactly
{"id", "action", "manager", "name", "version", "operation"}; no commands, URLs, scripts or paths. The resolved
version is returned in the existing per-request result file, not added to catalog auto-updates.

  acc-packages                          process the queued requests
  acc-packages --daily                  check everything; update what has auto-update on
  acc-packages --install codex copilot  install now (deploy/install.sh), catalog update policy
"""
from __future__ import annotations

import os as _compat_os
import runpy as _compat_runpy
import stat as _compat_stat
from pathlib import Path as _CompatPath

def _compat_reader(relative):
    # Root runs most of these helpers: load only a reader owned like this script that no one else can change,
    # and never fall back past an installed reader that fails the check. Exit 2 also makes acc-guard block.
    here = _CompatPath(__file__).resolve()
    mine = here.stat()
    for candidate in (here.with_name("acc_env.py"), here.parent / relative):
        try:
            info = candidate.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            break
        if _compat_stat.S_ISREG(info.st_mode) and info.st_uid == mine.st_uid and not info.st_mode & 0o002 and (
                not info.st_mode & 0o020 or info.st_gid == mine.st_gid):
            if _compat_os.geteuid() == 0:
                for path in (candidate, *candidate.parents):
                    try:
                        checked = path.stat(follow_symlinks=False)
                    except OSError:
                        break
                    sticky = _compat_stat.S_ISDIR(checked.st_mode) and checked.st_mode & _compat_stat.S_ISVTX
                    if checked.st_uid != 0 or (checked.st_mode & 0o022 and not sticky):
                        break
                else:
                    return _compat_runpy.run_path(str(candidate))
                break
            return _compat_runpy.run_path(str(candidate))
        break
    print(f"{here.name}: refusing an unsafe or missing settings reader beside it", file=__import__("sys").stderr)
    raise SystemExit(2)


