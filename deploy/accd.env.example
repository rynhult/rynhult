# /etc/default/accd: this machine's ACC settings. deploy/setup.sh writes it; or copy this file there and edit.
# accd.service and acc-hoststate load it; every value has a neutral default in code. Restart accd after edits.
# The URL people open ACC at (comma-separated if several).
ACC_ALLOWED_ORIGINS=https://acc.example.com
# Where published sites' DNS records point: the public address, and the LAN address for private-only sites.
ACC_ORIGIN_PUBLIC_IP=203.0.113.10
ACC_ORIGIN_INTERNAL_IP=10.0.0.20
# Zone whose wildcard certificate Caddy holds (names under it need no new certificate).
ACC_WILDCARD_ZONE=example.com
# Private preview DNS suffix (default: wildcard zone, otherwise ACC hostname).
# Cloudflare mode requires this to equal ACC_WILDCARD_ZONE; configure private wildcard DNS.
#ACC_PREVIEW_DOMAIN=example.com
# Home of the agent account new sessions run as (its name is shown in the UI); see deploy/broker/acc-agent-add.
ACC_AGENT_HOME=/home/alex-agent
# One broker per agent account (acc-broker@<account>.socket), and the user whose Docker stacks ACC brings up.
ACC_BROKER_SOCKET_DIR=/run/acc-broker
ACC_SERVICES_ACCOUNT=alex
# Agent CLIs installed besides Claude Code (deploy/install.sh installs them, pinned): codex, copilot.
ACC_AGENT_CLIS="codex"
# How the dashboard names this machine (defaults to the hostname).
ACC_HOST_LABEL=acc-host
# Zones names may be published in (comma-separated; default: the wildcard zone).
#ACC_PUBLISH_ZONES=example.com
# Mounts the Host page reports (space-separated; default: every disk-backed filesystem).
#ACC_HOSTSTATE_MOUNTS=/ /srv
# Git backup (docs/MULTIHOST.md): the address machines' brokers push project backups to (default: the first https
# address above). Backups are off when there is none.
#ACC_BACKUP_URL=https://acc.example.com

# Optional: the GitHub owner/repository root may install updates from. Default: derived from ACC_SOURCE_URL.
# ACC_UPDATE_REPOSITORY=example/acc
# An explicit empty value disables privileged installation. Private token: data/secrets/update_token (acc 0600).

# Optional database backend (empty/unset keeps ACC_DATA_DIR/acc.db). See docs/POSTGRESQL.md.
# Install the postgres Python extra and preserve/provision vault.key before opting in.
# Store any credentials only in this protected environment file.
#ACC_DATABASE_URL=postgresql+psycopg://db.example.lan/acc?sslmode=verify-full

# Optional manual HA (PostgreSQL only): unique stable main name; every start is standby.
# Follow docs/HIGH-AVAILABILITY.md before enabling on matching builds.
# ACC_HA_NODE_ID=main-a

# Own-machine group collaboration: opt-in, after account and platform qualification.
# ACC_GROUPS_REMOTE=1
