#!/usr/bin/python3 -I
"""acc-accounts: root helper that creates agent accounts for people an owner invites from Rynhult.

accd (user acc, unprivileged) can't create Linux users. It drops /srv/acc/accounts/requests/<id>.json
({"id", "account"}) and acc-accounts.path starts this helper, which:
  - accepts only a name ending in "-agent" (lowercase letters, digits, dashes),
  - refuses an existing user unless it already is a Rynhult agent account (then it's a no-op),
  - runs acc-agent-add <account> --roots /srv/acc/workspaces-<account> (no admin groups, its own root, no limits),
  - writes /srv/acc/accounts/results/<id>.json for accd (root:acc 0640).
It never takes commands, paths or options from the request.
"""
from __future__ import annotations

import os as _compat_os
import runpy as _compat_runpy
import stat as _compat_stat
from pathlib import Path as _CompatPath

def _compat_reader(relative):
    # Root runs most of these helpers: load only a reader owned like this script that no one else can change,
    # and never fall back past an installed reader that fails the check. Exit 2 also makes acc-guard block.
    here = _CompatPath(__file__).resolve()
    mine = here.stat()
    for candidate in (here.with_name("acc_env.py"), here.parent / relative):
        try:
            info = candidate.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            break
        if _compat_stat.S_ISREG(info.st_mode) and info.st_uid == mine.st_uid and not info.st_mode & 0o002 and (
                not info.st_mode & 0o020 or info.st_gid == mine.st_gid):
            if _compat_os.geteuid() == 0:
                for path in (candidate, *candidate.parents):
                    try:
                        checked = path.stat(follow_symlinks=False)
                    except OSError:
                        break
                    sticky = _compat_stat.S_ISDIR(checked.st_mode) and checked.st_mode & _compat_stat.S_ISVTX
                    if checked.st_uid != 0 or (checked.st_mode & 0o022 and not sticky):
                        break
                else:
                    return _compat_runpy.run_path(str(candidate))
                break
            return _compat_runpy.run_path(str(candidate))
        break
    print(f"{here.name}: refusing an unsafe or missing settings reader beside it", file=__import__("sys").stderr)
    raise SystemExit(2)


_compat = _compat_reader("../../src/acc/env.py")
environment = _compat["environment"]
Environment = _compat["Environment"]

import json
import os
import pwd
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(environment.get("ACC_ACCOUNTS_ROOT", "/srv/acc/accounts"))
BROKER_ENV = Path(environment.get("ACC_BROKER_ENV_DIR", "/etc/acc/broker"))
AGENT_ADD = environment.get("ACC_AGENT_ADD", "/usr/local/sbin/acc-agent-add")
WORKSPACES = environment.get("ACC_WORKSPACES_PARENT", "/srv/acc")
ACCOUNT_RE = re.compile(r"[a-z][a-z0-9-]{0,23}-agent")
ID_RE = re.compile(r"[a-z0-9-]{4,64}")


class Refused(Exception):
    pass


def is_agent_account(account: str) -> bool:
    env = BROKER_ENV / f"{account}.env"
    if not env.exists():
        return False
    values = Environment(dict(line.split("=", 1) for line in env.read_text().splitlines()
                              if "=" in line and not line.startswith("#")))
    return values.get("ACC_BROKER_ROLE") == "agents"


def user_exists(account: str) -> bool:
    try:
        pwd.getpwnam(account)
        return True
    except KeyError:
        return False


def create(account: str) -> str:
    if not ACCOUNT_RE.fullmatch(account):
        raise Refused("agent account names are lowercase letters, digits and dashes, ending in -agent")
    if user_exists(account):
        if is_agent_account(account):
            return f"{account} already exists"
        raise Refused(f"a user named {account} already exists and isn't a Rynhult agent account")
    result = subprocess.run([AGENT_ADD, account, "--roots", f"{WORKSPACES}/workspaces-{account}"],
                            capture_output=True, text=True, timeout=300)
    if result.returncode:
        raise Refused(f"acc-agent-add failed: {(result.stderr or result.stdout).strip()[-300:]}")
    return f"{account} created"


def write_result(request_id: str, payload: dict) -> None:
    results = ROOT / "results"
    results.mkdir(exist_ok=True)
    tmp = results / f".{request_id}.tmp"
    tmp.write_text(json.dumps(payload))
    os.chmod(tmp, 0o640)
    try:
        shutil.chown(tmp, group="acc")
    except (LookupError, PermissionError):
        pass
    tmp.replace(results / f"{request_id}.json")


def process(path: Path) -> dict:
    request_id = path.stem
    try:
        request = json.loads(path.read_text())
        if not isinstance(request, dict) or request.get("id") != request_id or not ID_RE.fullmatch(request_id):
            raise Refused("bad request")
        result = {"ok": True, "account": request.get("account"), "detail": create(str(request.get("account", "")))}
    except (Refused, ValueError, OSError, subprocess.TimeoutExpired) as error:
        result = {"ok": False, "detail": str(error)}
    if ID_RE.fullmatch(request_id):
        write_result(request_id, result)
    path.unlink(missing_ok=True)
    return result


def prune_results(max_age: float = 3600) -> None:
    """accd reads its result within a minute; older ones go."""
    import time
    for path in (ROOT / "results").glob("*.json"):
        if time.time() - path.stat().st_mtime > max_age:
            path.unlink(missing_ok=True)


def main() -> int:
    prune_results()
    for path in sorted((ROOT / "requests").glob("*.json")):
        print(path.name, json.dumps(process(path)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
