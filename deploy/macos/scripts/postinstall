#!/bin/sh
# The Rynhult package's postinstall (runs as root, from Installer). It installs nothing itself: the node runs as the
# signed-in user, so Rynhult Setup (deploy/macos/acc-setup.sh behind a dialog) is opened as that user, in their session.
#   $3: the volume installed to. Installed elsewhere than the running system, or from the command line
#   (installer -pkg, which sets COMMAND_LINE_INSTALL), or with nobody signed in: only say how to finish.
set -eu
target=${3:-/}
target=${target%/}  # "" for the running system
app="$target/Applications/ACC Setup.app"
later() {
  echo "Rynhult: $1. To finish, the person who will use Rynhult on this Mac opens Rynhult Setup from Applications."
  exit 0
}
[ -z "$target" ] || later "installed to $3, not the running system"
[ -z "${COMMAND_LINE_INSTALL:-}" ] || later "installed from the command line"
user=$(stat -f %Su /dev/console 2>/dev/null || true)
case $user in
  ''|root|loginwindow|_mbsetupuser) later "nobody is signed in at this Mac's screen" ;;
esac
uid=$(id -u "$user" 2>/dev/null) || later "cannot find the user $user"
[ "$uid" != 0 ] || later "the user at the screen is root"
# In the user's GUI session (launchctl asuser) and as the user (sudo -u): Rynhult Setup, and all it runs, never as root.
# open returns at once, so Installer finishes while Rynhult Setup asks for the command.
echo "Rynhult: opening Rynhult Setup for $user"
launchctl asuser "$uid" sudo -u "$user" -H open -a "$app" || later "could not open Rynhult Setup"
exit 0
