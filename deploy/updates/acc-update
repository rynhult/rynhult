#!/usr/bin/python3 -I
"""Root-owned entry point; the source tree is root-owned too."""

import os as _compat_os
# Both offline and queued updates create service-readable application trees.
# Private staging, backups and credentials retain their explicit modes.
_compat_os.umask(0o022)
import runpy as _compat_runpy
import stat as _compat_stat
from pathlib import Path as _CompatPath


def _compat_reader(relative):
    # Root runs most of these helpers: load only a reader owned like this script that no one else can change,
    # and never fall back past an installed reader that fails the check. Exit 2 also makes acc-guard block.
    here = _CompatPath(__file__).resolve()
    mine = here.stat()
    for candidate in (here.with_name("acc_env.py"), here.parent / relative):
        try:
            info = candidate.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            break
        if _compat_stat.S_ISREG(info.st_mode) and info.st_uid == mine.st_uid and not info.st_mode & 0o002 and (
                not info.st_mode & 0o020 or info.st_gid == mine.st_gid):
            if _compat_os.geteuid() == 0:
                for path in (candidate, *candidate.parents):
                    try:
                        checked = path.stat(follow_symlinks=False)
                    except OSError:
                        break
                    sticky = _compat_stat.S_ISDIR(checked.st_mode) and checked.st_mode & _compat_stat.S_ISVTX
                    if checked.st_uid != 0 or (checked.st_mode & 0o022 and not sticky):
                        break
                else:
                    return _compat_runpy.run_path(str(candidate))
                break
            return _compat_runpy.run_path(str(candidate))
        break
    print(f"{here.name}: refusing an unsafe or missing settings reader beside it", file=__import__("sys").stderr)
    raise SystemExit(2)


_compat = _compat_reader("../../src/acc/env.py")
environment = _compat["environment"]
Environment = _compat["Environment"]
import importlib.util
import os
import stat
import sys
from pathlib import Path

offline = sys.argv[1:2] == ['--offline']
package = ((Path(__file__).resolve().parents[2] if offline else
            Path(environment.get('ACC_UPDATE_SOURCE', '/srv/acc/app'))) / 'src/acc')
try:
    if not package.is_absolute():
        raise ValueError('relative update source')
    if os.geteuid() == 0:
        for path in (package, *package.parents, *package.rglob('*')):
            info = path.lstat()
            sticky = path in package.parents and stat.S_ISDIR(info.st_mode) and info.st_mode & stat.S_ISVTX
            if (info.st_uid != 0 or (info.st_mode & 0o022 and not sticky)
                    or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode))):
                raise ValueError('unprotected update source')
except (OSError, ValueError):
    print('acc-update: refusing an unsafe update source', file=sys.stderr)
    raise SystemExit(2)

init = package / '__init__.py'
spec = importlib.util.spec_from_file_location('acc', init, submodule_search_locations=[str(package)])
module = importlib.util.module_from_spec(spec)
sys.modules['acc'] = module
exec(compile(init.read_bytes(), str(init), 'exec'), module.__dict__)
if offline:
    from acc.offline_upgrade import main
    raise SystemExit(main(sys.argv[2:]))
from acc.update_helper import main

raise SystemExit(main())
