# Install: /etc/systemd/system/acc-broker@.socket ; enabled per account by acc-agent-add (acc-broker@<account>.socket)
# The broker's socket, made by systemd in a root-owned folder: only accd (group acc) can connect, and the account's own
# processes (its agents) can neither connect nor replace it. Held across broker restarts.
[Unit]
Description=Rynhult broker socket for %i

[Socket]
ListenStream=/run/acc-broker/%i.sock
SocketUser=root
SocketGroup=acc
SocketMode=0660
DirectoryMode=0755

[Install]
Alias=rynhult-broker@.socket
WantedBy=sockets.target
