#!/usr/bin/python3 -I
"""acc-containers: the trusted container launcher (docs/CONTAINER-LAUNCHER.md). Root; stdlib only; never imports Rynhult.

An account's broker runs with NoNewPrivileges, so rootless Podman can't map its user namespace from there. This helper
asks PID 1 for a new service instead: `systemd-run --uid=<agent account> --property=Delegate=yes`, with the account's
limits, outside the broker's process tree. Podman, crun, conmon and the agent all run as the agent account, never root.

systemd starts one copy per connection on /run/acc-containers.sock (acc-containers.socket, Accept=yes); stdin is the
connection. One JSON line in, one JSON line out:

  {"version": 1, "request_id": "...", "operation": "launch"|"status"|"stop",
   "session_id": "...", "generation": 3, "policy_id": "default"}

Nothing else is accepted: no argv, paths, units, environment, images, mounts or systemd properties. Authority:
  - the caller is the account's broker: its peer uid is the account's, and its pid is the MainPID of
    acc-broker@<account>.service (the agent processes share the uid but are never the broker's main process);
  - the session is the account's: accd (the control plane, user acc) wrote a grant for it in grants/<session>.json,
    a folder only acc can write, naming the account, generation, policy, the session's private checkout and run
    folder, its command and the account's limits;
  - the image is one of Rynhult's pinned images: policy.json (root-owned) maps the policy id to a sha256 image ID;
  - the mounts are the session's private checkout and run folder only, each a real directory owned by the account,
    reached without following a link, under the account's own roots (its broker settings, root-owned).
Every refusal has a stable code; every launch, stop, refusal and cleanup is audited (audit/, read into Rynhult's audit log
by accd). `acc-containers --reconcile` (acc-containers-reconcile.timer) stops containers whose grant went away or
changed, enforces the disk limit, retries failed cleanups and reports units it has no record of without touching them.
"""
from __future__ import annotations

import os as _compat_os
import runpy as _compat_runpy
import stat as _compat_stat
from pathlib import Path as _CompatPath


def _compat_reader(relative):
    # Root runs most of these helpers: load only a reader owned like this script that no one else can change,
    # and never fall back past an installed reader that fails the check. Exit 2 also makes acc-guard block.
    here = _CompatPath(__file__).resolve()
    mine = here.stat()
    for candidate in (here.with_name("acc_env.py"), here.parent / relative):
        try:
            info = candidate.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            break
        if _compat_stat.S_ISREG(info.st_mode) and info.st_uid == mine.st_uid and not info.st_mode & 0o002 and (
                not info.st_mode & 0o020 or info.st_gid == mine.st_gid):
            if _compat_os.geteuid() == 0:
                for path in (candidate, *candidate.parents):
                    try:
                        checked = path.stat(follow_symlinks=False)
                    except OSError:
                        break
                    sticky = _compat_stat.S_ISDIR(checked.st_mode) and checked.st_mode & _compat_stat.S_ISVTX
                    if checked.st_uid != 0 or (checked.st_mode & 0o022 and not sticky):
                        break
                else:
                    return _compat_runpy.run_path(str(candidate))
                break
            return _compat_runpy.run_path(str(candidate))
        break
    print(f"{here.name}: refusing an unsafe or missing settings reader beside it", file=__import__("sys").stderr)
    raise SystemExit(2)


_compat = _compat_reader("../../src/acc/env.py")
environment = _compat["environment"]
Environment = _compat["Environment"]

