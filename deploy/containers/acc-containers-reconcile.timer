# Install: /etc/systemd/system/acc-containers-reconcile.timer ; systemctl enable --now acc-containers-reconcile.timer
[Unit]
Description=Rynhult: reconcile container sessions every minute

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1min
AccuracySec=10s

[Install]
Alias=rynhult-containers-reconcile.timer
WantedBy=timers.target
