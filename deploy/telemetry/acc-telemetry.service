[Unit]
Description=Rynhult owner-hosted telemetry collector
After=local-fs.target

[Service]
Type=simple
User=acc-telemetry
# Own group; Caddy reaches the socket through SupplementaryGroups=acc-telemetry (caddy-limits.conf).
Group=acc-telemetry
WorkingDirectory=/opt/acc-telemetry
Environment=PYTHONPATH=/opt/acc-telemetry
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ACC_COLLECTOR_DB=/var/lib/acc-telemetry/telemetry.sqlite
ExecStart=/opt/acc-telemetry/venv/bin/python -m uvicorn --factory deploy.telemetry.app:create_app --uds /run/acc-telemetry/collector.sock --workers 1 --lifespan on --no-access-log --log-config /opt/acc-telemetry/logging.json --proxy-headers --forwarded-allow-ips=* --limit-concurrency 32 --backlog 64 --timeout-keep-alive 5 --ws none
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=acc-telemetry
StateDirectoryMode=0700
RuntimeDirectory=acc-telemetry
RuntimeDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemoryMax=256M
CPUQuota=50%
TasksMax=32
LimitNOFILE=256

[Install]
Alias=rynhult-telemetry.service
WantedBy=multi-user.target
