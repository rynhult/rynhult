[Unit]
Description=Rynhult reviewed folder operations

[Socket]
ListenStream=/run/acc-folder-policy/helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=acc
# Parent permits traversal after reboot; socket mode and worker peer UID
# restrict connections to the main service. Agents cannot replace the socket.
DirectoryMode=0755
Accept=yes
MaxConnections=4

[Install]
Alias=rynhult-folder-policy.socket
WantedBy=sockets.target
